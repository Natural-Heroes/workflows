# Storyblok Management API Token (required)
# Generate at: https://app.storyblok.com/#/me/account?tab=token
STORYBLOK_MANAGEMENT_TOKEN=your_management_token_here

# Storyblok Space ID (required)
STORYBLOK_SPACE_ID=123456

# Storyblok Public/Preview Token (optional, for read-only access)
STORYBLOK_DEFAULT_PUBLIC_TOKEN=your_public_token_here

# Storyblok Region (optional, default: eu)
# Options: eu, us, ca, ap, cn
STORYBLOK_REGION=eu

# Server port (optional, default: 3001)
PORT=3001

# Node environment (optional, default: development)
NODE_ENV=development

# Base path prefix for all endpoints (optional, default: "")
# Example: /storyblok would mount endpoints at /storyblok/health, /storyblok/mcp
BASE_PATH=
