# Server configuration
PORT=3001

# Google Cloud credentials - provide as JSON string
# The entrypoint script will write this to /app/credentials.json
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# GA4 Property ID (optional - can also be specified per-request)
# Format: just the numeric ID, e.g., 251977777
GOOGLE_PROJECT_ID=251977777
